{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/out/${presetName}",
            "installDir": "${sourceDir}/build/install",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "FDTD_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_CUDA_HOST_COMPILER": "g++" }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_CUDA_HOST_COMPILER": "clang++" }
        },
        {
            "name": "debug",
            "displayName": "Debug (gcc)",
            "inherits": ["base", "gcc"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "Release (gcc)",
            "inherits": ["base", "gcc"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "clang-debug",
            "displayName": "Debug (clang)",
            "inherits": ["base", "clang"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-release",
            "displayName": "Release (clang)",
            "inherits": ["base", "clang"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "ci-cpu",
            "displayName": "CI, CPU backends only, warnings as errors",
            "inherits": ["base", "gcc"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FDTD_WITH_CUDA": "OFF",
                "FDTD_WERROR": "ON"
            }
        },
        {
            "name": "cuda",
            "displayName": "CUDA required (gcc, Debug), warnings as errors",
            "inherits": ["base", "gcc"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FDTD_WITH_CUDA": "ON",
                "FDTD_WERROR": "ON"
            }
        },
        {
            "name": "exact",
            "displayName": "Exact (gcc, Release, no contracted multiply-adds)",
            "inherits": ["base", "gcc"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FDTD_EXACT": "ON"
            }
        },
        {
            "name": "bench",
            "displayName": "Benchmark (gcc, Release, no tests or samples)",
            "inherits": ["base", "gcc"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FDTD_BUILD_TESTS": "OFF",
                "FDTD_BUILD_SAMPLES": "OFF"
            }
        },
        {
            "name": "bench-native",
            "displayName": "Benchmark for the CPU of the build machine (the bench preset with -march=native)",
            "inherits": ["bench"],
            "cacheVariables": { "FDTD_NATIVE": "ON" }
        },
        {
            "name": "profile",
            "displayName": "Profile (the bench preset with symbols, frame pointers and CUDA line info)",
            "inherits": ["bench"],
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer",
                "CMAKE_CUDA_FLAGS": "-lineinfo"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "clang-debug", "configurePreset": "clang-debug" },
        { "name": "clang-release", "configurePreset": "clang-release" },
        { "name": "ci-cpu", "configurePreset": "ci-cpu" },
        { "name": "cuda", "configurePreset": "cuda" },
        { "name": "exact", "configurePreset": "exact" },
        { "name": "bench", "configurePreset": "bench" },
        { "name": "bench-native", "configurePreset": "bench-native" },
        { "name": "profile", "configurePreset": "profile" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug", "inherits": "base", "configurePreset": "debug" },
        { "name": "release", "inherits": "base", "configurePreset": "release" },
        { "name": "clang-debug", "inherits": "base", "configurePreset": "clang-debug" },
        { "name": "clang-release", "inherits": "base", "configurePreset": "clang-release" },
        { "name": "ci-cpu", "inherits": "base", "configurePreset": "ci-cpu" },
        { "name": "cuda", "inherits": "base", "configurePreset": "cuda" },
        { "name": "exact", "inherits": "base", "configurePreset": "exact" }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "steps": [
                { "type": "configure", "name": "debug" },
                { "type": "build", "name": "debug" },
                { "type": "test", "name": "debug" }
            ]
        },
        {
            "name": "ci-cpu",
            "steps": [
                { "type": "configure", "name": "ci-cpu" },
                { "type": "build", "name": "ci-cpu" },
                { "type": "test", "name": "ci-cpu" }
            ]
        }
    ]
}
