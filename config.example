# Settings of the benchmark sweep and the profile run, read by tools/bench_sweep.sh (make bench)
# and tools/profile_run.sh (make profile).
#
# Copy this file to config in the project root and edit it; config is not tracked.
# It is sourced by bash. Lists are space-separated.

# --- Benchmark sweep ---

# Time steps per sample
BENCH_STEPS=500

# Samples per configuration
BENCH_REPEAT=10

# Backends: serial, openmp, cuda, or all for every compiled one
BENCH_BACKENDS="all"

# OpenMP thread counts; 12 was the stable choice on the reference 8-core CPU
BENCH_THREADS="12"

# PASSIVE sleeps at barriers, kind to a shared machine; a value set in the environment wins
export OMP_WAIT_POLICY="${OMP_WAIT_POLICY:-PASSIVE}"

# Variant names or default; each backend runs the ones it reads (see benchmark --help)
BENCH_VARIANTS="default"

# Weak scaling: OpenMP on nx = BENCH_WEAK_NX by ny = threads * BENCH_WEAK_NX; empty for none
BENCH_WEAK_NX=""

# Grid sizes, nx = ny
BENCH_SIZES="128 256 512 1024 2048"

# interleaved (one sample per configuration per round, evens out load spikes) or grouped
BENCH_ORDER="interleaved"

# Outer boundary: pml, or pec or pmc with no PML
BENCH_BOUNDARY="pml"

# Steps between snapshots copied to the host inside the timed run; 0 for none
BENCH_SNAPSHOT_EVERY=0

# Run label written into the CSV, telling apart runs of the same configuration; empty for none
BENCH_LABEL=""

# --- Profile run ---

# Tools: perf-stat perf-record callgrind cachegrind memcheck nsys ncu (nsys, ncu need cuda)
PROFILE_TOOLS="perf-stat perf-record callgrind cachegrind memcheck"

# Backend profiled: serial, openmp or cuda
PROFILE_BACKEND="serial"

# Thread count profiled, for OpenMP
PROFILE_THREADS=1

# Grid size, nx = ny, under perf, nsys and ncu
PROFILE_PERF_SIZE=1024

# Time steps under perf, nsys and ncu
PROFILE_PERF_STEPS=200

# Grid size, nx = ny, under valgrind, which runs far slower than perf
PROFILE_VALGRIND_SIZE=256

# Time steps under valgrind
PROFILE_VALGRIND_STEPS=200
