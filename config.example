# Settings of the benchmark sweep and the profile run, read by tools/bench_sweep.sh (make bench)
# and tools/profile_run.sh (make profile).
#
# Copy this file to config in the project root and edit it; config is not tracked.
# It is sourced by bash. Lists are space-separated.

# --- Benchmark sweep ---

# Time steps per sample
BENCH_STEPS=500

# Samples per configuration
BENCH_REPEAT=10

# Backends: serial, openmp, cuda, or all for every compiled one
BENCH_BACKENDS="all"

# Thread counts, for OpenMP only
BENCH_THREADS="1 2 4"

# Variants, OpenMP and CUDA names mixed: OpenMP SCHEDULE[:WxH][+simd][+phase] with rows,
# collapse2, tiles or tasks; CUDA KERNEL[:BXxBY] with fused or split; or default. Each backend
# runs the names it reads, or default when it reads none; serial runs default only
BENCH_VARIANTS="default"

# Weak scaling: per thread count p, OpenMP on nx = BENCH_WEAK_NX and ny = p * BENCH_WEAK_NX, into
# benchmark_weak_<timestamp>.csv; empty for none
BENCH_WEAK_NX=""

# Grid sizes, nx = ny
BENCH_SIZES="128 256 512 1024 2048"

# Order of the samples: interleaved takes one sample of each configuration per round, so a load
# spike from another process falls on all of them alike; grouped takes each configuration's
# samples in a row
BENCH_ORDER="interleaved"

# Label of the run, written into its CSV; the report tells apart by label the runs that share a
# configuration, such as runs under different OMP_* settings; empty for none
BENCH_LABEL=""

# --- Profile run ---

# Tools, any of: perf-stat perf-record callgrind cachegrind memcheck nsys ncu; nsys and ncu
# need PROFILE_BACKEND="cuda"
PROFILE_TOOLS="perf-stat perf-record callgrind cachegrind memcheck"

# Backend and thread count profiled
PROFILE_BACKEND="serial"
PROFILE_THREADS=1

# Grid size, nx = ny, and time steps under perf, nsys and ncu
PROFILE_PERF_SIZE=1024
PROFILE_PERF_STEPS=200

# Grid size and time steps under valgrind, which runs far slower than perf
PROFILE_VALGRIND_SIZE=256
PROFILE_VALGRIND_STEPS=200
